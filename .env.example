# Copy to .env locally. Do not commit real passwords.
POSTGRES_DB=civicconnect
POSTGRES_USER=civicconnect
POSTGRES_PASSWORD=change-this-locally
DB_URL=jdbc:postgresql://localhost:5433/civicconnect
DB_USERNAME=civicconnect
DB_PASSWORD=change-this-locally

# Development-only Spring Security users.
DEV_REQUESTER_USERNAME=requester
DEV_REQUESTER_PASSWORD=change-this-locally
DEV_STAFF_USERNAME=staff
DEV_STAFF_PASSWORD=change-this-locally
DEV_MANAGER_USERNAME=manager
DEV_MANAGER_PASSWORD=change-this-locally
