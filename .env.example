# Copy locally. Supply your own strong passwords; no seeded credentials.
POSTGRES_DB=civicconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5433/civicconnect
DB_USERNAME=civicconnect_runtime
DB_PASSWORD=
MIGRATION_DB_USERNAME=civicconnect_migrator
MIGRATION_DB_PASSWORD=
RC_VERSION=roles-and-rls
# Browser key: enable Maps JavaScript API + Places API (New), enable billing,
# restrict to authorized website origins/referrers and only required APIs.
GOOGLE_MAPS_API_KEY=
# Create a Map ID in Google Cloud for production; DEMO_MAP_ID is for local demo only.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Controlled Firebase cutover: do not change to firebase until migration + bootstrap are complete.
AUTH_MODE=legacy
FIREBASE_PROJECT_ID=civicconnect-3ed04
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=civicconnect-3ed04.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=
# Private service account file: ./secrets/firebase-service-account.json (never commit)
BREVO_NOTIFICATIONS_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_NAME=CivicConnect
BREVO_SENDER_EMAIL=inl2group13@gmail.com
BREVO_REPLY_TO=inl2group13@gmail.com
PUBLIC_APP_URL=http://localhost:8085
# Optional: public HTTPS URL to branded logo image for email clients.
CIVICCONNECT_LOGO_URL=
